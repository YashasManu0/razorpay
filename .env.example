# Application Settings
DEBUG=true
ENVIRONMENT=development

# Database Settings
# For local SQLite (Zero setup needed):
DATABASE_URL=sqlite:///./negotiator.db
# For PostgreSQL with pgvector:
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/negotiator

# Google Gemini API
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Razorpay Sandbox Credentials
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_demo_key
RAZORPAY_KEY_SECRET=rzp_test_secret_demo
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_12345
# Set to 'true' to use the zero-friction built-in sandbox mock without real API keys
USE_MOCK_PAYMENTS=true

# Inventory and Offer Expiration
INVENTORY_LOCK_TTL_SECONDS=600
OFFER_TTL_SECONDS=900
